{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chapter-titler",
  "version": "0.1.0",
  "identifier": "com.chapter-titler.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "chapter-titler",
        "width": 800,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/JavenKazebee/chapter-titler/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBREQ0RENEQTU1MkY4ODQKUldTRStGS2x6VTNkMnNybUJGdW9tdFVhajVBc09sYnpDN1lKdEp6YkZWQnVMekM0VENuL09jbkwK"
    }
  }
}
